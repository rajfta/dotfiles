    "fetchOriginBeforeWorktreeCreation": true,
    "githubIntegrationEnabled": true,
    "globalScripts": [],
    "inAppNotificationsEnabled": true,
    "moveNotifiedWorktreeToTop": false,
    "muteNotificationsForActiveSurface": true,
