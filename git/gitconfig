[user]
	email = rajfta@gmail.com
	name = rajfta
[core]
	editor = code --wait
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default

# Work identity overrides: separate identity per client/employer context.
[includeIf "gitdir:~/work/peakfs/"]
	path = ~/.gitconfig-peakfs
[includeIf "gitdir:~/work/bupa/"]
	path = ~/.gitconfig-bupa
