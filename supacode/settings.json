      "selectWorktree6": {
        "isEnabled": true,
        "keyCode": 22,
        "modifiers": 5
      },
      "selectWorktree7": {
        "isEnabled": true,
        "keyCode": 26,
        "modifiers": 5
      },
      "selectWorktree8": {
        "isEnabled": true,
        "keyCode": 28,
        "modifiers": 5
      },
      "selectWorktree9": {
        "isEnabled": true,
        "keyCode": 25,
        "modifiers": 5
