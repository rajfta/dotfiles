# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Disable Oh My Zsh theme (using Starship instead)
ZSH_THEME=""

# Plugins
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Editor
export EDITOR='code --wait'
export VISUAL='code --wait'

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Add VSCode to PATH (Homebrew's cask already symlinks `code`; this covers a
# manual /Applications install too)
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Solana
export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Aliases
alias c='/Applications/Cursor.app/Contents/Resources/app/bin/cursor'
alias p='pnpm'
alias b='bun'
alias ll='eza -la --icons --git'
alias lt='eza --tree --level=2 --icons'
alias cat='bat'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status'
alias glog='git log --oneline --graph --decorate -20'
alias lint='pnpm lint'
alias types='pnpm check-types'

# Second Brain
brain() {
  local vault="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Second Brain"
  cd "$vault" || return 1
  # snapshot anything uncommitted so this session is always revertable
  if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
    git add -A && git commit -qm "snapshot: before session $(date '+%Y-%m-%d %H:%M')" \
      && echo "brain: snapshotted pending changes"
    (git push -q origin main &>/dev/null &)
  fi
  claude "$@"
}

# fzf
eval "$(fzf --zsh)"

# zoxide (smarter cd)
eval "$(zoxide init zsh)"

# Starship prompt (must be last)
eval "$(starship init zsh)"
